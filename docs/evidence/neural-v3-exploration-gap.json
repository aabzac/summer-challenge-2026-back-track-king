  "definitions": {
    "selection": "For each of 8 rounds and each head independently: np.unique(np.linspace(0, populationDecisions-1, min(128,populationDecisions), dtype=int)); zero-based complete decision indices. Exactly 128 per head per round, 1024 per head overall. No outcome-based selection.",
    "student": "Exact quantized exported weights-(round-1).json used by that collection round; SHA matched against its meta.json. Java-order float32 inference from train_outcome_v2.java_scores.",
    "sameStudentArgmax": "Recorded chosen action has logit exactly equal to the maximum over the full legal/guarded candidates for that same student. Exact float32 ties count as agreement.",
    "meanPmax": "Mean probability of a single maximum-probability action under softmax(student logits / T), not the combined mass of tied maxima.",
    "meanEntropyT1": "Arithmetic mean Shannon entropy in nats over selected complete decisions at T=1.",
    "aggregation": "Equal weight per selected decision; not reweighted to original round populations.",
    "logpTolerance": "abs(reconstructed chosen logp - saved actual behavior logp) <= 1e-4 + 1e-5 * abs(saved logp); every sampled decision passed.",
    "temperatureComparison": "Only the already-inspected T=1 and T=0.5 probabilities on the same recorded states; no rollout at T=0.5."
  },
  "limitations": [
    "Deterministic diagnostic subsample, not a random sample, full corpus census, strength benchmark, or confidence interval.",
    "Deployment uses argmax plus Gaussian NOISE=0.1 and runtime deadlines; pure argmax is an approximation, not the exact deployed action distribution.",
    "Earlier frozen-teacher agreement 26.33% measures a different quantity; these counts use each round actual student.",
    "T=0.5 probabilities do not represent the new states that lower-temperature collection would reach and do not establish improved playing strength.",
    "Collection had offline 60000-ms student budget; this diagnostic does not measure runtime truncation in deployment."
  ],
